{
    "name": "laranail/chrono",
    "description": "Timezones, formatting and humanised time for Laravel \u2014 a tzdata-parity IANA catalogue with a fluent query builder, a resolver for messy input, and daylight-saving conversion with explicit gap and ambiguity policies.",
    "keywords": [
        "laravel",
        "laranail",
        "date",
        "datetime",
        "timezone",
        "tzdata",
        "dst",
        "daylight-saving",
        "icu",
        "i18n",
        "carbon"
    ],
    "homepage": "https://opensource.simtabi.com/products/laranail/chrono",
    "license": "MIT",
    "authors": [
        {
            "name": "Simtabi LLC",
            "email": "opensource@simtabi.com",
            "homepage": "https://opensource.simtabi.com",
            "role": "Organization"
        },
        {
            "name": "Imani Manyara",
            "email": "imani@simtabi.com",
            "role": "Maintainer"
        }
    ],
    "support": {
        "issues": "https://github.com/laranail/chrono/issues",
        "source": "https://github.com/laranail/chrono",
        "docs": "https://opensource.simtabi.com/documentation/laranail/chrono/"
    },
    "require": {
        "php": "^8.5",
        "ext-calendar": "*",
        "ext-intl": "*",
        "illuminate/cache": "^13.0",
        "illuminate/console": "^13.0",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/support": "^13.0",
        "illuminate/translation": "^13.0",
        "illuminate/validation": "^13.0",
        "illuminate/view": "^13.0",
        "laranail/console": "^0.1",
        "laranail/enumerator": "^0.1",
        "laranail/package-tools": "^0.1",
        "nesbot/carbon": "^3.10 || ^4.0",
        "psr/clock": "^1.0",
        "psr/simple-cache": "^3.0"
    },
    "require-dev": {
        "deptrac/deptrac": "^4.7",
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.30",
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-arch": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "php-parallel-lint/php-parallel-lint": "^1.4",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^12.0",
        "rector/rector": "^2.5.8",
        "roave/security-advisories": "dev-latest"
    },
    "suggest": {
        "giggsey/libphonenumber-for-php": "Resolves a phone number to its candidate timezones (planned for v0.2)."
    },
    "autoload": {
        "psr-4": {
            "Simtabi\\Laranail\\Chrono\\": "src/"
        },
        "files": [
            "helpers/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Simtabi\\Laranail\\Chrono\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest --no-coverage --colors=always --exclude-group=tzdata",
        "test-coverage": "vendor/bin/pest --coverage --colors=always",
        "test-dirty": "@test --dirty --compact",
        "test-tzdata": "vendor/bin/pest --no-coverage --colors=always --group=tzdata",
        "lint": [
            "@parallel-lint",
            "@pint",
            "@phpstan",
            "@deptrac",
            "@rector"
        ],
        "parallel-lint": "vendor/bin/parallel-lint --exclude vendor src tests",
        "pint": "@php vendor/bin/laranail-pint --test",
        "pint-fix": "@php vendor/bin/laranail-pint --parallel",
        "phpstan": [
            "vendor/bin/phpstan analyse -c phpstan.neon --no-progress --memory-limit=512M",
            "vendor/bin/phpstan analyse -c phpstan-core.neon --no-progress --memory-limit=512M"
        ],
        "deptrac": "php tools/deptrac-guard.php",
        "rector": "vendor/bin/rector process --dry-run --no-progress-bar",
        "rector-fix": "vendor/bin/rector process",
        "sync": "@php vendor/bin/testbench laranail::chrono.sync",
        "sync-check": "@php tools/sync-check.php",
        "composer-audit": "@composer audit --no-interaction",
        "format": "@pint-fix"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Simtabi\\Laranail\\Chrono\\Providers\\ChronoServiceProvider"
            ],
            "aliases": {
                "Chrono": "Simtabi\\Laranail\\Chrono\\Facades\\Chrono",
                "Timezones": "Simtabi\\Laranail\\Chrono\\Facades\\Timezones"
            }
        },
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/laranail/console"
        },
        {
            "type": "vcs",
            "url": "https://github.com/laranail/enumerator"
        },
        {
            "type": "vcs",
            "url": "https://github.com/laranail/package-tools"
        },
        {
            "type": "composer",
            "url": "https://repo.packagist.org",
            "exclude": [
                "laranail/*"
            ]
        },
        {
            "packagist.org": false
        }
    ]
}
