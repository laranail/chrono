{
    "preset": "laravel",
    "rules": {
        "declare_strict_types": true,
        "ordered_imports": {
            "sort_algorithm": "alpha"
        },
        "no_unused_imports": true,
        "concat_space": {
            "spacing": "one"
        },
        "phpdoc_align": {
            "align": "left"
        }
    },
    "exclude": [
        "vendor"
    ],
    "notPath": [
        "src/Core/Enums/Timezone.php",
        "src/Core/Enums/TimezoneLegacy.php",
        "src/Core/Enums/TimezoneAbbreviation.php",
        "src/Core/Enums/Tz.php",
        "src/Core/Timezone/Support/AliasMap.php",
        "src/Core/Timezone/Support/CountryZones.php",
        "src/Enums/TimezoneEnum.php"
    ]
}
