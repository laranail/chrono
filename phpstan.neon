# The Laravel shell. src/Core has its own, stricter config — see phpstan-core.neon.
includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 8
    paths:
        - src
        # A trait PHPStan sees no user of is not analysed at all, so the consumer fixtures are in
        # scope deliberately — they are the only thing that makes the concerns checkable.
        - tests/Fixtures
        - tests/TestCase.php
    excludePaths:
        - src/Core
        - tests/Fixtures/Core
        - vendor
    treatPhpDocTypesAsCertain: false
